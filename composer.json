{
    "name": "emirustaoglu/fcm",
    "description": "A lightweight PHP client for Firebase Cloud Messaging (FCM) HTTP v1 API.",
    "type": "library",
    "version": "0.0.1",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-openssl": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "emirustaoglu\\fcm\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "emirustaoglu\\fcm\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:syntax": "find src tests -name '*.php' -print0 | xargs -0 -n1 php -l"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}